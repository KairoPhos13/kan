<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- kan! rebrand (ADR-0011): our artifacts carry the kan! identity. -->
    <Description>kan! — grab your instrument. You kan!</Description>
    <AssemblyName>kan</AssemblyName>
    <AssemblyTitle>kan!</AssemblyTitle>
    <Title>kan!</Title>
    <Product>kan!</Product>
    <ApplicationIcon>lazer.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Required for deployment. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <StartupHookSupport>false</StartupHookSupport>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <PropertyGroup>
    <StartupObject>osu.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game.Tournament\osu.Game.Tournament.csproj"/>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj"/>
    <!--
      kan! rebrand (ADR-0011) / owner direction 2026-10-12: the stock game
      modes (osu!standard, taiko, catch, mania) are NOT part of kan!. The
      ruleset slots belong to instruments (see game/docs/instrument-modes.md
      in the kan-rhythm monorepo). The ruleset projects remain in the
      repository for tests/tooling; they are simply not shipped in the
      desktop client. Logged in game/docs/fork-divergence.md as F-9.
    -->
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="System.IO.Packaging" Version="10.0.12"/>
    <!-- Held back due to invite bug in newer versions. See https://github.com/Lachee/discord-rpc-csharp/issues/286 -->
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51"/>
    <PackageReference Include="Velopack" Version="1.2.0"/>
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="lazer.ico"/>
  </ItemGroup>
  <!-- kan! rebrand (ADR-0011), fork F-21: kan!'s art and sounds (game/brand in the
       kan-rhythm repository) ship in a brand folder that overrides osu!'s resources. -->
  <ItemGroup Label="kan! brand" Condition="Exists('..\..\brand')">
    <Content Include="..\..\brand\**\*" Exclude="..\..\brand\README.md" Link="brand\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <ItemGroup Label="Windows Icons">
    <Content Include="*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
